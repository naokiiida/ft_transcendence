# ============================================
# ft_transcendence Local Development
# ============================================
# Copy this file to .env.local and fill in secrets.
#
# Usage:
#   Docker:    make local
#   No Docker: make npm  (frontend/.env.example & backend defaults handle URLs)

# --- Domain (unused locally, but required by compose) ---
DOMAIN=localhost

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/api/ws

# --- Backend ---
CORS_ORIGIN=http://localhost:3000
PORT=3001

# --- 42 OAuth ---
# Register at: https://profile.intra.42.fr/oauth/applications
# NOTE: Redirect URI に http://localhost:3001/api/auth/42/callback を追加してください
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_CALLBACK_URL=http://localhost:3001/api/auth/42/callback

# --- Session ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=
