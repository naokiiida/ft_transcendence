# ============================================
# ft_transcendence Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
#
# Defaults are set for pong.taiida.com production.
# For local development, create .env.local to override (see below).
#
# Custom domain:
#   Replace every "pong.taiida.com" with your domain.

# --- Domain ---
# Used in Traefik routing rules and as the base for other URLs.
DOMAIN=pong.taiida.com

# --- Frontend ---
# Baked into the Next.js build. Must match the public URL users visit.
NEXT_PUBLIC_API_URL=https://pong.taiida.com
NEXT_PUBLIC_WS_URL=wss://pong.taiida.com/api/ws

# --- Backend ---
# CORS_ORIGIN must match the frontend origin exactly (scheme + host).
CORS_ORIGIN=https://pong.taiida.com
# Internal port the backend listens on inside the container.
# PORT=3001

# --- 42 OAuth ---
# Register at: https://profile.intra.42.fr/oauth/applications
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_REDIRECT_URI=https://pong.taiida.com/api/auth/42/callback

# --- Session ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- API Key (optional) ---
# If set, protects admin endpoints. If unset, a random key is generated
# and printed to backend logs on startup.
# API_KEY=

# --- TLS (Let's Encrypt DNS Challenge) ---
# Cloudflare API token with Zone:DNS:Edit permission.
# Create at: Cloudflare Dashboard → My Profile → API Tokens → Create Token
#   → Use template "Edit zone DNS"
#   → Zone Resources: Include → Specific zone → taiida.com
CF_API_TOKEN=
# Email for Cloudflare account & Let's Encrypt expiry notifications.
CF_API_EMAIL=

# --- Traefik ---
TRAEFIK_LOG_LEVEL=INFO

# --- Subdomains ---
# Grafana and Storybook use separate first-level subdomains
# (Cloudflare Universal SSL only covers *.taiida.com, not *.pong.taiida.com)
DOMAIN_GRAFANA=grafana.taiida.com
DOMAIN_STORYBOOK=storybook.taiida.com

# --- Cloudflare Tunnel ---
# Create at: Cloudflare Zero Trust → Networks → Tunnels → Create
# Configure public hostnames → https://traefik:443 with Origin Server Name:
#   pong.taiida.com      (Origin Server Name: pong.taiida.com)
#   grafana.taiida.com   (Origin Server Name: grafana.taiida.com)
#   storybook.taiida.com (Origin Server Name: storybook.taiida.com)
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================
# Local Development (.env.local)
# ============================================
# For local dev WITHOUT Docker, no .env is needed (code defaults to localhost).
# For local dev WITH Docker, create .env.local with:
#
#   NEXT_PUBLIC_API_URL=http://localhost:3001
#   NEXT_PUBLIC_WS_URL=ws://localhost:3001/api/ws
#   CORS_ORIGIN=http://localhost:3000
#   FT_REDIRECT_URI=http://localhost:3001/api/auth/callback
#
# Then run: docker compose --env-file .env.local up --build
