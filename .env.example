# ============================================
# ft_transcendence Environment Configuration
# ============================================
# Development works WITHOUT .env.local (fallback defaults are used).
# Only create .env.local for production or to override defaults.

# --- Frontend (frontend/.env.local) ---
# Defaults: http://localhost:3001, ws://localhost:3001/api/ws
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/api/ws

# --- Backend (backend/.env.local) ---
# Default: 3001
# PORT=3001

# --- 42 OAuth (required for production) ---
# Register at: https://profile.intra.42.fr/oauth/applications
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_REDIRECT_URI=https://pong.taiida.com/api/auth/callback

# --- Session (required for production) ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Backend CORS (required for production) ---
# Set to the production origin so cookies and CORS work correctly.
# In dev mode the backend defaults to http://localhost:3000.
CORS_ORIGIN=https://pong.taiida.com

# --- Cloudflare Tunnel (required for production) ---
# Create at: Cloudflare Zero Trust → Networks → Tunnels → Create
# Configure public hostname: pong.taiida.com → http://traefik:80
CLOUDFLARE_TUNNEL_TOKEN=
