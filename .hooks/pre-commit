#!/bin/bash
# Pre-commit hook: Prevent db.query() usage - use db.prepare() instead
# Prepared statements are inherently safe from SQL injection

set -e

echo "Checking for unsafe db.query() usage..."

# Get list of staged files (only .ts and .js files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js|tsx|jsx)$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FOUND_ISSUES=0

for file in $STAGED_FILES; do
    [ -f "$file" ] || continue

    # Check staged content only
    STAGED_CONTENT=$(git show ":$file" 2>/dev/null || true)
    [ -z "$STAGED_CONTENT" ] && continue

    # Block ANY db.query() usage
    MATCHES=$(echo "$STAGED_CONTENT" | grep -nE 'db\.query\s*\(' || true)
    if [ -n "$MATCHES" ]; then
        echo ""
        echo "ERROR: db.query() usage detected in $file"
        echo "$MATCHES" | head -5
        echo ""
        echo "Use db.prepare() instead for SQL injection safety:"
        echo "  db.prepare('SELECT * FROM users WHERE id = ?').get(id)"
        echo "  db.prepare('INSERT INTO users (name) VALUES (?)').run(name)"
        echo ""
        FOUND_ISSUES=1
    fi
done

if [ $FOUND_ISSUES -eq 1 ]; then
    echo "Commit blocked: Replace db.query() with db.prepare()"
    echo "Bypass with 'git commit --no-verify' if needed."
    exit 1
fi

echo "No db.query() usage detected."
exit 0
