# ============================================
# ft_transcendence Environment Configuration
# Copy to .env and fill in values
# ============================================

# --- 42 OAuth ---
# Register at: https://profile.intra.42.fr/oauth/applications
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_REDIRECT_URI=https://pong.taiida.com/api/auth/callback

# --- Session ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Environment ---
# development | production
DENO_ENV=development
