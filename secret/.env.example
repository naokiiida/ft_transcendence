# 42 OAuth Configuration
# Get your credentials at: https://profile.intra.42.fr/oauth/applications

# Client ID (UID) from your 42 OAuth application
FT_UID="u-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Client Secret from your 42 OAuth application
# NOTE: 42 rotates secrets periodically - check your app settings for the current secret
FT_SECRET="s-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Secret expiration tracking (optional but recommended)
SECRET_VALID_UNTIL="2026-01-26"
SECRET_RENEW_DATE="2026-01-19"

# Redirect URI - MUST match EXACTLY what's configured in your 42 app settings
# Common gotchas:
# - localhost vs 127.0.0.1 are NOT equivalent
# - trailing slash matters
# - port must match your dev server
REDIRECT_URI="http://localhost:3000/callback"

# Database Configuration
# For local dev: SQLite file (simple, no Docker needed)
DATABASE_URL="file:./prisma/dev.db"

# For Turso cloud (production):
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-auth-token"
